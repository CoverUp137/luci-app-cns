config cns 'main'
	option proxy_key 'Host'
	option udp_flag 'httpUDP'
	option encrypt_password ''
	option tcp_timeout '600'
	option udp_timeout '30'
	option enable_httpdns '1'
	option enable_dns_tcp_over_udp '1'
	option enable_tfo '0'
	list listen_addr ':2222'
	option cert_file ''
	option key_file ''

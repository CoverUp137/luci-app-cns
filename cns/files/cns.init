#!/bin/sh /etc/rc.common
# CNS (CuteBi Network Server) init script

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/cns
JSON=/var/etc/cns.json

# 直接 source 本脚本（比如测试时）没有 rc.common 的 jshn，这里补一下
[ -r /usr/share/libubox/jshn.sh ] && . /usr/share/libubox/jshn.sh

uget() {
	local v
	v="$(uci -q get "cns.main.$1")"
	[ -n "$v" ] || v="$2"
	printf '%s' "$v"
}

unum() {
	case "$(uget "$1" "$2")" in
		''|*[!0-9]*) echo "$2" ;;
		*) uget "$1" "$2" ;;
	esac
}

ulist_count() {
	local n=0 v
	for v in $(uget "$1" ''); do
		[ -n "$v" ] && n=$((n + 1))
	done
	echo "$n"
}

# 只在非空时写数组：cns 里 "空数组" 和 "没有这个键" 行为不同
json_add_uci_list() {
	local v
	json_add_array "$1"
	for v in $(uget "$2" ''); do
		[ -n "$v" ] && json_add_string "" "$v"
	done
	json_close_array
}

gen_config() {
	local v cert key

	mkdir -p /var/etc || return 1

	json_cleanup
	json_init

	json_add_int Tcp_timeout "$(unum tcp_timeout 600)"
	json_add_int Udp_timeout "$(unum udp_timeout 30)"

	[ "$(ulist_count listen_addr)" -gt 0 ] && json_add_uci_list Listen_addr listen_addr

	json_add_string Proxy_key "$(uget proxy_key Meng)"
	json_add_string Udp_flag "$(uget udp_flag httpUDP)"
	json_add_string Encrypt_password "$(uget encrypt_password '')"
	json_add_string Pid_path /var/run/cns.pid

	json_add_boolean Enable_dns_tcpOverUdp "$(uget enable_dns_tcp_over_udp 1)"
	json_add_boolean Enable_httpDNS "$(uget enable_httpdns 1)"
	json_add_boolean Enable_TFO "$(uget enable_tfo 0)"

	cert="$(uget cert_file '')"
	key="$(uget key_file '')"
	if [ -n "$cert" ] && [ -n "$key" ]; then
		if [ ! -r "$cert" ] || [ ! -r "$key" ]; then
			logger -t cns "证书或私钥不可读，改用自签名证书"
			cert=""; key=""
		fi
	elif [ -n "$cert" ] || [ -n "$key" ]; then
		logger -t cns "证书和私钥必须同时填写，改用自签名证书"
		cert=""; key=""
	fi

	json_add_object Tls
	[ "$(ulist_count tls_listen_addr)" -gt 0 ] && json_add_uci_list Listen_addr tls_listen_addr
	[ "$(ulist_count autocert_hosts)" -gt 0 ] && json_add_uci_list AutoCertHosts autocert_hosts
	json_add_string CertFile "$cert"
	json_add_string KeyFile "$key"
	json_close_object

	json_dump > "$JSON"
}

start_service() {
	local addr n=0

	for addr in $(uget listen_addr '') $(uget tls_listen_addr ''); do
		[ -n "$addr" ] && n=$((n + 1))
	done
	if [ "$n" -eq 0 ]; then
		logger -t cns "没有配置任何监听地址，不启动"
		return 1
	fi

	gen_config || { logger -t cns "生成 $JSON 失败"; return 1; }
	[ -s "$JSON" ] || { logger -t cns "$JSON 为空"; return 1; }

	procd_open_instance
	procd_set_param command "$PROG" -json "$JSON"
	# cns 自带一个 fork 守护循环，和 procd 冲突；CHILD_PORC=true 让它直接在当前进程跑
	procd_set_param env CHILD_PORC=true
	procd_set_param limits nofile="1048576 1048576"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger cns
}

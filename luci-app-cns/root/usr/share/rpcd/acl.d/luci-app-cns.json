{
	"luci-app-cns": {
		"description": "Grant access to CNS configuration",
		"read": {
			"file": {
				"/etc/config/cns": [
					"read"
				],
				"/var/log/cns.log": [
					"read"
				]
			},
			"ubus": {
				"service": [
					"list"
				],
				"luci": [
					"getInitList"
				]
			},
			"uci": [
				"cns"
			]
		},
		"write": {
			"file": {
				"/etc/config/cns": [
					"write"
				],
				"/etc/init.d/cns": [
					"exec"
				],
				"/var/log/cns.log": [
					"write"
				]
			},
			"ubus": {
				"luci": [
					"setInitAction"
				]
			},
			"uci": [
				"cns"
			]
		}
	}
}
